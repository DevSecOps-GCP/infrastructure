          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-prod"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(http_request_duration_seconds_bucket{namespace=\"learnhub\",route=~\"$route\",method=~\"$method\"}[$__range])))",
          "legendFormat": "p95",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-prod"
          },
          "expr": "sum by (method, route) (increase(http_request_duration_seconds_count{namespace=\"learnhub\",route=~\"$route\",method=~\"$method\",status=~\"5..\"}[$__range])) / clamp_min(sum by (method, route) (increase(http_request_duration_seconds_count{namespace=\"learnhub\",route=~\"$route\",method=~\"$method\"}[$__range])), 1e-9)",
          "legendFormat": "5xx ratio",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
