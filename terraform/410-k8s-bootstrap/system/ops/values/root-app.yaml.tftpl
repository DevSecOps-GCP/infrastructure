applications:
  root:
    namespace: ${namespace}
    project: default
    source:
      repoURL: ${repo_url}
      targetRevision: main
      path: ${path}
      directory:
        recurse: true
    destination:
      server: https://kubernetes.default.svc
      namespace: ${namespace}
    syncPolicy:
      automated:
        prune: true
        selfHeal: true
